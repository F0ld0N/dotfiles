// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+shift+g",
        "command": "workbench.scm.focus"
    },
    {
        "key": "ctrl+k ctrl+d",
        "command": "-editor.action.moveSelectionToNextFindMatch",
        "when": "editorFocus"
    },
    {
        "key": "ctrl+k ctrl+d",
        "command": "vscode-containers.views.dockerContexts.focus"
    }
]
